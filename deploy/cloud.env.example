# Contract for compose.cloud.yml when deploying outside the provided AWS stack.
# Do not commit the populated file. Prefer a cloud secret manager in production.
API_IMAGE=
WEB_IMAGE=
ML_IMAGE=

DATABASE_URL=
REDIS_URL=
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SSL

S3_BUCKET=
AWS_REGION=ap-south-1
FRONTEND_URL=https://fdx.example.com

JWT_SECRET=
JWT_ISSUER=fdx
JWT_AUDIENCE=fdx-web
FDX_SUPER_ADMIN_EMAIL=admin@example.com
FDX_SUPER_ADMIN_PASSWORD=

EMAIL_FROM=noreply@example.com
EMAIL_WEBHOOK_SECRET=

# These values require production calibration before launch.
MATCH_AUTO_THRESHOLD=0.85
MATCH_REVIEW_THRESHOLD=0.65
UNIQUE_FACE_CLUSTER_THRESHOLD=0.75
MATCH_RUNNER_UP_MARGIN=0.08
THRESHOLD_PROFILE_VERSION=default-v1
FDX_DETECTOR_MODEL_VERSION=retinaface-r50-v1
FDX_EMBEDDER_MODEL_VERSION=adaface-ir101-ms1mv2-v1
CONSENT_POLICY_VERSION=2026-08-13
FDX_DEVICE=cpu
