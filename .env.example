POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
FDX_SUPER_ADMIN_EMAIL=superadmin@fdx.io
FDX_SUPER_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
FDX_WEB_PORT=8080
FDX_ENVIRONMENT=development

# Optional managed service overrides for production
# DATABASE_URL=postgresql+psycopg://user:password@rds-host:5432/fdx
# REDIS_URL=rediss://elasticache-host:6379/0
# KAFKA_BOOTSTRAP_SERVERS=broker-1:9094,broker-2:9094
# ML_SERVICE_URL=http://ml:3000

# Email: outbox, resend, or ses
EMAIL_PROVIDER=outbox
EMAIL_FROM=FDX <noreply@example.com>
RESEND_API_KEY=

# Object storage: local or s3
STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=ap-south-1
